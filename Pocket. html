<!DOCTYPE html>
<html>
<head>
    <title>PocketSmart AI</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <style>
        body{
            font-family:Arial;
            background:#eef4ff;
            margin:0;
            padding:20px;
        }

        .box{
            max-width:700px;
            margin:auto;
            background:white;
            padding:25px;
            border-radius:15px;
            box-shadow:0 5px 20px #ccc;
        }

        h1{
            text-align:center;
            color:#4f46e5;
        }

        input,select,button{
            width:100%;
            padding:12px;
            margin:8px 0;
            border-radius:8px;
            border:1px solid #ccc;
            box-sizing:border-box;
        }

        button{
            background:#4f46e5;
            color:white;
            border:0;
            cursor:pointer;
            font-weight:bold;
        }

        button:hover{
            background:#3730a3;
        }

        .cards{
            display:grid;
            grid-template-columns:repeat(2,1fr);
            gap:10px;
            margin-top:20px;
        }

        .card{
            padding:15px;
            background:#f1f5ff;
            border-radius:10px;
            text-align:center;
        }

        .card b{
            font-size:20px;
        }

        table{
            width:100%;
            margin-top:20px;
            border-collapse:collapse;
        }

        th,td{
            padding:10px;
            border-bottom:1px solid #ddd;
            text-align:center;
        }

        .delete{
            background:#ef4444;
            padding:7px;
        }

        #message{
            margin-top:20px;
            padding:15px;
            background:#dcfce7;
            border-radius:10px;
        }
    </style>
</head>

<body>

<div class="box">

    <h1>💰 PocketSmart AI</h1>
    <p style="text-align:center;">Smart Budget Assistant</p>

    <h2>Monthly Budget</h2>

    <input id="income" type="number" value="30000"
           placeholder="Monthly Income">

    <select id="category">
        <option>Food</option>
        <option>Transport</option>
        <option>Shopping</option>
        <option>Bills</option>
        <option>Entertainment</option>
        <option>Health</option>
        <option>Education</option>
        <option>Other</option>
    </select>

    <input id="amount" type="number"
           placeholder="Expense Amount">

    <button onclick="addExpense()">➕ Add Expense</button>
    <button onclick="resetAll()">🔄 Reset</button>

    <div class="cards">

        <div class="card">
            <p>Income</p>
            <b id="incomeShow">₹30,000</b>
        </div>

        <div class="card">
            <p>Total Spent</p>
            <b id="spent">₹0</b>
        </div>

        <div class="card">
            <p>Remaining</p>
            <b id="remaining">₹30,000</b>
        </div>

        <div class="card">
            <p>Saving Target</p>
            <b id="saving">₹6,000</b>
        </div>

    </div>

    <h2>🧾 Expenses</h2>

    <table>
        <thead>
            <tr>
                <th>Category</th>
                <th>Amount</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody id="list">
        </tbody>
    </table>

    <div id="message">
        🤖 Enter your expenses to get a budget recommendation.
    </div>

</div>

<script>

let expenses = [];

function money(value){
    return "₹" + value.toLocaleString("en-IN");
}

function addExpense(){

    let income = Number(document.getElementById("income").value);
    let category = document.getElementById("category").value;
    let amount = Number(document.getElementById("amount").value);

    if(income <= 0){
        alert("Enter valid income");
        return;
    }

    if(amount <= 0){
        alert("Enter valid expense");
        return;
    }

    expenses.push({
        category:category,
        amount:amount
    });

    document.getElementById("amount").value = "";

    update();
}

function deleteExpense(index){

    expenses.splice(index,1);

    update();
}

function update(){

    let income = Number(document.getElementById("income").value);

    let total = 0;

    expenses.forEach(function(item){
        total += item.amount;
    });

    let remaining = income - total;
    let saving = income * 0.20;

    document.getElementById("incomeShow").innerText = money(income);
    document.getElementById("spent").innerText = money(total);
    document.getElementById("remaining").innerText =
        money(Math.max(remaining,0));
    document.getElementById("saving").innerText = money(saving);

    let list = document.getElementById("list");

    list.innerHTML = "";

    expenses.forEach(function(item,index){

        list.innerHTML += `
            <tr>
                <td>${item.category}</td>
                <td>${money(item.amount)}</td>
                <td>
                    <button class="delete"
                    onclick="deleteExpense(${index})">
                    Delete
                    </button>
                </td>
            </tr>
        `;
    });

    recommendation(income,total);
}

function recommendation(income,total){

    let percentage = (total / income) * 100;

    let message = document.getElementById("message");

    if(percentage >= 100){

        message.innerHTML =
        "⚠️ Expenses exceeded your income. Reduce spending immediately.";

    }
    else if(percentage >= 80){

        message.innerHTML =
        "⚠️ You have used more than 80% of your income. Control unnecessary expenses.";

    }
    else if(percentage >= 50){

        message.innerHTML =
        "💡 More than 50% is spent. Try to reduce expenses and increase savings.";

    }
    else{

        message.innerHTML =
        "✅ Great! Your spending is under control. Keep saving 20% of your income.";

    }
}

function resetAll(){

    expenses = [];

    document.getElementById("income").value = 30000;
    document.getElementById("amount").value = "";

    update();
}

document.getElementById("income")
.addEventListener("input",update);

update();

</script>

</body>
</html>
